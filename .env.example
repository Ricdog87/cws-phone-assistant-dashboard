# Vorlage. Kopie als .env.local anlegen, .env* ist von Git ausgenommen.

# Kontaktadresse für Nominatim (Nutzungsrichtlinie von OpenStreetMap), optional
VITE_NOMINATIM_EMAIL=

# Adresse der Salesforce-Oberfläche für Kalender und Aufgaben, kein Geheimnis.
# Leer bleibt https://cws-workwear.lightning.force.com, etwa für eine Sandbox überschreiben.
VITE_SALESFORCE_URL=

# Briefing über Sprachmodell
# Standard im Browser: rules (regelbasiert) oder llm
VITE_BRIEFING_MODE=rules
# Endpunkt des Proxys, nur ändern, wenn er als Serverless-Funktion woanders liegt
VITE_BRIEFING_ENDPOINT=/api/briefing

# Nur serverseitig, ohne VITE_-Präfix, gelangt nie in den Browser.
# OpenAI-kompatibler Chat-Completions-Endpunkt mit Unterstützung für json_schema.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Kopfzeile für den Schlüssel. Authorization (mit Bearer) oder z. B. api-key
LLM_AUTH_HEADER=Authorization
LLM_TIMEOUT_MS=12000
